{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stream",
  "version": "0.1.0",
  "identifier": "ca.hartwigdev.stream",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "stream",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyOUFCOTgyOERGNUU2QkUKUldTKzV2V05ncm1hc21DQU52TVpUeHdrdm9LSE9jYUxobmlXQTVSNzZvdVJuVVJOSm84RitSM3IK",
      "endpoints": [
        "https://github.com/Andrew1431/stream-right/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
