{
  "name": "stream",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --strict-vars false"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "desktop"
  ],
  "dependencies": {
    "mediabunny": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  },
  "license": "MIT",
  "cloudflare": {
    "bindings": {
      "CREATOR_KEY": {
        "description": "Password for making rooms. Use a long random string; friends only ever need invite links."
      },
      "REALTIME_APP_ID": {
        "description": "App ID of your app under **Realtime \u2192 Serverless SFU** in the Cloudflare dashboard."
      },
      "REALTIME_APP_SECRET": {
        "description": "App Secret of the same Realtime app."
      }
    }
  }
}
